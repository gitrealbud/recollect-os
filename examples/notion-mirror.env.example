# Copy to <your-vault>/.local/notion-sync/.env  (keep gitignored)
# Never commit tokens. Never put secrets inside vault notes.

NOTION_TOKEN=secret_or_ntn_xxxxxxxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional — title property name on the database (default Name)
# NOTION_TITLE_PROP=Name

# Optional — if the script is not run from the vault root
# NOTION_SYNC_ROOT=/path/to/your/vault
